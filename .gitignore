# --- Python 垃圾文件 ---
__pycache__/
*.pyc
*.pyo
*$py.class
venv/
.env

# --- 系统文件 ---
.DS_Store
Thumbs.db

# --- IDE 配置文件 ---
.idea/
.vscode/

# --- 插件运行生成的缓存与设置 ---
# 不上传生成的音频缓存
Cache/*
!Cache/.gitkeep

# 不上传你的个人设置（只保留默认模版）
system_settings.json
character_mappings.json

# --- 模型文件 (防止上传几个G的大文件) ---
# 忽略 MyCharacters 下的所有内容，但保留文件夹结构
MyCharacters/*
!MyCharacters/.gitkeep
# 再次确保不上传具体的模型权重文件
*.pth
*.ckpt
*.safetensors

# --- 日志 ---
*.log

# --- 用户数据 (不上传个人使用数据) ---
# data 目录包含 favorites.db 等用户数据
data/
!data/.gitkeep

# --- 本地备份与环境 ---
runtime_backup/

# --- 任务管理与本地配置 ---
management/
.agents/
.gemini/
GEMINI.md