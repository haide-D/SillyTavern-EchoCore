# --- Python 垃圾文件 ---
__pycache__/
*.pyc
*.pyo
*$py.class
venv/
.env

# --- 系统文件 ---
.DS_Store
Thumbs.db

# --- IDE 配置文件 ---
.idea/

# --- 插件运行生成的缓存与设置 ---
# 不上传生成的音频缓存
Cache/*
!Cache/.gitkeep

# 不上传你的个人设置（只保留默认模版）
system_settings.json
character_mappings.json
manifest.json

# --- 模型文件 (防止上传几个G的大文件) ---
# 忽略 MyCharacters 下的所有内容，但保留文件夹结构
MyCharacters/*
!MyCharacters/.gitkeep
# 再次确保不上传具体的模型权重文件
*.pth
*.ckpt
*.safetensors

# --- 日志 ---
*.log

# --- 用户数据 (不上传个人使用数据) ---
# data 目录包含 favorites.db、自定义主题(themes)、头像(avatars) 等
data/
!data/.gitkeep

# 剧本工坊自定义电话与偷听预设 (只保留内置 builtin，忽略本地 custom)
presets/custom/*
!presets/custom/**/.gitkeep

# --- 文档和临时文件 ---
# docs 目录包含临时文档、日志等
docs/
setup_runtime.bat
scratch/

# --- AI Configuration & Backups ---
.agents/
.gemini/
GEMINI.md
runtime_backup/
management/
